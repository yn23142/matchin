rules_version = '2';
// MATCHIN Firestore 보안 규칙
// - 로그인한 사람만 읽고 쓸 수 있어요.
// - 후기는 1인 1매장 1건, 동석 인증 후기는 그 모임에 체크인한 사람만.
// - 모임 참여는 한 달 4회까지 무료(usage 문서로 확인).
// - 체크인 코드는 주최자만 볼 수 있어요.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function meetPath(mid) { return /databases/$(database)/documents/meets/$(mid); }
    function monthId() { return uid() + '_' + string(request.time.year() * 100 + request.time.month()); }
    function shortText(v, n) { return v is string && v.size() <= n; }
    // 운영자: 이 Google 계정만
    function isAdmin() { return signedIn() && request.auth.token.email == 'lovesick2154@gmail.com' && request.auth.token.email_verified == true; }
    // 이용 정지 중이 아님
    function notBanned() { return !exists(/databases/$(database)/documents/bans/$(uid())) || get(/databases/$(database)/documents/bans/$(uid())).data.until < request.time; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2 && request.resource.data.nickname.size() <= 12
        && request.resource.data.consents.age14 == true
        && request.resource.data.consents.terms is string
        && request.resource.data.consents.privacy is string;
      // 회원 탈퇴
      allow delete: if signedIn() && uid() == userId;
    }

    match /reviews/{rid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && notBanned()
        && request.resource.data.uid == uid()
        && rid == request.resource.data.st + '_' + uid()
        && request.resource.data.get('hidden', false) == (resource == null ? false : resource.data.get('hidden', false))
        && request.resource.data.s is int && request.resource.data.s >= 1 && request.resource.data.s <= 5
        && shortText(request.resource.data.t, 500)
        && (request.resource.data.v == 'none'
            || (request.resource.data.v == 'dine'
                && uid() in get(meetPath(request.resource.data.meet)).data.checkedIn
                && get(meetPath(request.resource.data.meet)).data.store == request.resource.data.st));
      allow delete: if signedIn() && resource.data.uid == uid();
      // 운영자: 숨김만 바꿀 수 있음
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'hiddenReason']);
    }

    match /usage/{key} {
      allow get: if signedIn() && key.matches(uid() + '_.*');
      allow list: if signedIn() && resource.data.uid == uid();
      // 모임 참여와 같은 일괄 쓰기에서만 1씩 늘어나요. 한 달 최대 4회.
      allow create: if signedIn() && key == monthId()
        && request.resource.data.uid == uid() && request.resource.data.count == 1;
      allow update: if signedIn() && key == monthId()
        && request.resource.data.uid == uid()
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 4;
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    match /meets/{mid} {
      allow read: if signedIn();
      allow create: if signedIn() && notBanned()
        && request.resource.data.host == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.checkedIn == []
        && request.resource.data.status == 'open'
        && request.resource.data.cap is int && request.resource.data.cap >= 3 && request.resource.data.cap <= 8
        && shortText(request.resource.data.title, 40);
      allow update: if signedIn() && (
        // 주최자: 제목·상태만
        (resource.data.host == uid() && resource.data.status != 'hidden'
          && request.resource.data.status in ['open', 'cancelled']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'status']))
        // 운영자: 상태(숨김·취소)와 사유만
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'hiddenReason']))
        // 참여: 나만 추가, 정원 이내, 이번 달 사용량이 함께 1 늘어남
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [uid()].toSet()
          && request.resource.data.members.size() <= resource.data.cap
          && resource.data.status == 'open' && notBanned()
          && getAfter(/databases/$(database)/documents/usage/$(monthId())).data.count
             == (exists(/databases/$(database)/documents/usage/$(monthId()))
                 ? get(/databases/$(database)/documents/usage/$(monthId())).data.count + 1 : 1))
        // 나가기: 나만 빠짐 (주최자는 불가)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && resource.data.members.toSet().difference(request.resource.data.members.toSet()) == [uid()].toSet()
          && resource.data.host != uid())
        // 체크인: 코드가 맞는 체크인 문서와 함께 나만 추가
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedIn'])
          && request.resource.data.checkedIn.toSet().difference(resource.data.checkedIn.toSet()) == [uid()].toSet()
          && uid() in resource.data.members
          && existsAfter(/databases/$(database)/documents/meets/$(mid)/checkins/$(uid())))
      );

      match /secret/{docId} {
        allow read: if signedIn() && get(meetPath(mid)).data.host == uid();
        allow create: if signedIn() && getAfter(meetPath(mid)).data.host == uid();
      }
      match /checkins/{userId} {
        allow read: if signedIn();
        allow create: if signedIn() && userId == uid()
          && uid() in get(meetPath(mid)).data.members
          && request.resource.data.code == get(/databases/$(database)/documents/meets/$(mid)/secret/code).data.code;
      }
      match /messages/{msgId} {
        allow read: if signedIn() && uid() in get(meetPath(mid)).data.members;
        allow create: if signedIn() && notBanned() && uid() in get(meetPath(mid)).data.members
          && request.resource.data.uid == uid()
          && (shortText(request.resource.data.get('t', ''), 500) && (request.resource.data.get('t', '') != '' || request.resource.data.get('card', 0) is string));
      }
    }

    match /communities/{cid}/messages/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn() && notBanned() && cid in ['heukseok', 'gopchang', 'freshmen']
        && request.resource.data.uid == uid()
        && (shortText(request.resource.data.get('t', ''), 500) && (request.resource.data.get('t', '') != '' || request.resource.data.get('card', 0) is string));
    }

    match /ratings/{rid} {
      allow read: if signedIn();
      allow create: if signedIn() && notBanned()
        && request.resource.data.rater == uid()
        && rid == request.resource.data.meet + '_' + uid() + '_' + request.resource.data.ratee
        && request.resource.data.ratee != uid()
        && request.resource.data.s is int && request.resource.data.s >= 1 && request.resource.data.s <= 5
        && uid() in get(meetPath(request.resource.data.meet)).data.checkedIn
        && request.resource.data.ratee in get(meetPath(request.resource.data.meet)).data.checkedIn;
      allow delete: if signedIn() && resource.data.rater == uid();
    }

    // 신고: 쓰기만 가능, 운영자가 Firebase 콘솔에서 확인
    match /reports/{rid} {
      allow create: if signedIn() && request.resource.data.by == uid()
        && request.resource.data.type in ['review', 'meet', 'user']
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 40
        && shortText(request.resource.data.get('memo', ''), 300)
        && request.resource.data.status == 'open';
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledAt']);
    }

    // 이용 정지: 운영자만 쓰기, 본인 확인용으로 로그인 회원 읽기
    match /bans/{userId} {
      allow read: if signedIn();
      allow write: if isAdmin() && userId != uid();
    }

    // 공지: 운영자만 쓰기
    match /notices/{nid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
